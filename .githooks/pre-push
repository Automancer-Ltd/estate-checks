#!/usr/bin/env bash
set -euo pipefail
# Estate secret-scanning pre-push (house standard, from projects/personal/duet).
#
# DELIBERATELY LIVE — do not turn this off, and do not "fix" it back to a warning.
# Installed 2026-08-29 after a live credential was committed and pushed to this
# estate on 2026-08-25.
#
# git feeds a pre-push hook its ref list on STDIN exactly ONCE. Capture it up
# front so anything added after this point can still read it, and so "no refs"
# can be told apart from "an earlier check drained stdin".
REFS="$(cat)"
DEST="${2:-}"  # the URL this push goes to
red='\033[0;31m'; green='\033[0;32m'; nc='\033[0m'

# THIS HOOK SCANS THE COMMITS A PUSH ADDS (t12242, 1 Nov 2026).
#
# `.githooks/pre-commit` scans staged changes, but `git commit --no-verify`
# skips it. On 1 Nov 2026 no estate repository's CI scanned a branch pushed
# without a pull request: most scanned pull requests only, some pushes to main
# only, a few nothing (t12083, t12242). So the scan runs here, before the
# commits leave the machine, in every repository, whatever its CI does. It
# costs about a second. Do not drop it because a repository's CI also scans.
#
# It scans only the commits the destination does not already have, never full
# history (CI does that where it is configured). `-m` includes merge diffs, so a
# secret added while resolving a merge conflict is scanned too. Copied from
# Global-Diversity-Practice/maia#507, which was reviewed three times.
blocked() { echo -e "${red}✗ Push blocked:${nc} $*"; exit 1; }
# No gitleaks blocks the push (t13562). It used to warn and push anyway, and a
# branch pushed without a pull request is scanned nowhere else. To push unscanned
# on purpose, give a reason in ESTATE_PRE_PUSH_UNSCANNED; the hook records it in
# the clone's estate-unscanned-pushes.log beside its git config.
if ! command -v gitleaks >/dev/null 2>&1; then
  reason="${ESTATE_PRE_PUSH_UNSCANNED:-}"
  if [[ -z "${reason//[[:space:]]/}" ]]; then
    echo -e "${red}✗ Push blocked:${nc} gitleaks is NOT installed on this device, so the pushed commits cannot be scanned."
    echo "  Install it: https://github.com/gitleaks/gitleaks/releases"
    echo "  To push unscanned anyway, say why: ESTATE_PRE_PUSH_UNSCANNED='<reason>' git push ..."
    exit 1
  fi
  log="$(git rev-parse --git-common-dir)/estate-unscanned-pushes.log"
  # Never record a credential: drop everything up to the last '@' of the
  # authority, since a password can carry an unencoded '@' (t13727).
  dest_shown=$(sed -E 's#(://)[^/]*@#\1#' <<<"$DEST")
  while read -r _ local_sha remote_ref _; do
    [[ -n "${local_sha:-}" ]] || continue
    printf '%s\t%s@%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${USER:-${USERNAME:-?}}" \
      "$(hostname 2>/dev/null || echo ?)" "$dest_shown" "$remote_ref" "$local_sha" "${reason//[$'\t\n']/ }" >>"$log"
  done <<<"$REFS"
  echo -e "${red}!${nc} gitleaks is NOT installed: pushing UNSCANNED because ESTATE_PRE_PUSH_UNSCANNED says: ${reason}"
  echo "  Recorded in ${log}"
  exit 0
fi
# What the destination already holds, asked of the destination itself. Local
# remote-tracking refs are not used: they describe the fetch URL, which can
# differ from the push URL, and they can be stale.
#
# The lookup has a time limit (t12392): a destination that accepts the
# connection and never answers would otherwise hold the push forever. A normal
# lookup takes about a second (3,082 refs from GitHub, measured 1 Nov 2026 on
# Windows and Linux), so 30 seconds stops only a stall and still leaves time to
# type an SSH passphrase. perl does the timing because Linux, macOS and Git for
# Windows all ship it, and stock macOS has no `timeout`. The lookup stays in
# the push's process group so prompts still reach the terminal, and gets TERM
# first so git stops the ssh or https helper it started. Its errors go to a
# file because such a helper can outlive it and would hold a pipe open.
# A helper that ignores TERM keeps running after the hook; the push is still
# blocked on time (t13727). Without perl the lookup has no time limit.
lookup_limit=${ESTATE_PRE_PUSH_LOOKUP_TIMEOUT:-30}
lookup_err=$(mktemp); trap 'rm -f "$lookup_err"' EXIT
bounded() { # <seconds> <command...>; exits 124 when the time runs out
  command -v perl >/dev/null 2>&1 || { "${@:2}"; return; }
  perl -MPOSIX=:sys_wait_h -e '
    my $limit = shift;
    my $pid = fork // exit 125;
    if (!$pid) { exec { $ARGV[0] } @ARGV; exit 127 }
    $SIG{ALRM} = sub {
      kill "TERM", $pid;
      for (1 .. 20) { waitpid($pid, WNOHANG) and exit 124; select undef, undef, undef, 0.1 }
      kill "KILL", $pid; exit 124;
    };
    alarm $limit;
    waitpid $pid, 0;
    exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
  ' "$@"
}
lookup=0
dest_refs=$(bounded "$lookup_limit" git ls-remote -- "$DEST" 2>"$lookup_err") || lookup=$?
[[ $lookup -ne 124 ]] || blocked "the destination did not answer within ${lookup_limit} seconds, so nothing was scanned."
[[ $lookup -eq 0 ]] || blocked "could not list the destination's refs, so nothing was scanned: $(tail -n 2 "$lookup_err")"
# Only commits this clone has can be ancestors of what is pushed. No lazy
# fetch: in a partial clone each missing ref would otherwise be a network fetch.
held=$(cut -f1 <<<"$dest_refs" | sort -u | GIT_NO_LAZY_FETCH=1 git cat-file --batch-check='%(objectname) %(objecttype)' | awk '$2 == "commit" {print $1}') || blocked "could not read the destination's refs, so nothing was scanned."
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" && "$local_sha" != "$zero" ]] || continue  # branch deletion
  # The commits this push adds, and the boundary: the destination's commits they
  # build on. gitleaks gets only commit hashes, never a remote name or path.
  walk=$({ echo "$local_sha"; awk 'NF {print "^" $1}' <<<"$held"; } | git rev-list --boundary --stdin) || blocked "could not list the commits pushed to ${remote_ref}, so nothing was scanned."
  grep -q '^[0-9a-f]' <<<"$walk" || continue  # the destination already has them all
  opts="-m ${local_sha}"
  boundary=$(grep '^-' <<<"$walk" | cut -c2- | paste -sd' ' -) || true
  [[ -z "$boundary" ]] || opts+=" --not ${boundary}"
  status=0
  output=$(gitleaks git --redact --config .gitleaks.toml --no-banner --exit-code 99 --log-opts="$opts" 2>&1) || status=$?
  if [[ $status -eq 99 ]]; then
    echo -e "${red}✗ Push blocked:${nc} gitleaks found potential secrets in the commits pushed to ${remote_ref}."
    echo "  (Findings are deliberately not printed. To see redacted detail: gitleaks git --redact --config .gitleaks.toml --log-opts=\"${opts}\")"
    exit 1
  elif [[ $status -ne 0 ]]; then
    echo -e "${red}✗ Push blocked:${nc} the gitleaks scan itself FAILED to run (exit ${status}), which is not a scan verdict. Fix the scan; do not bypass it."
    echo "${output}" | tail -n 5
    exit 1
  fi
done <<<"$REFS"
echo -e "${green}✓ pre-push secret scan passed${nc}"
